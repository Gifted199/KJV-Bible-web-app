# Copy this file to .env and fill in the values. .env is git-ignored: never commit real keys.
# One setting per line, no quotes, no spaces around "=". Keys must stay on one line.
# Test them with: uv run python -m app.main check   (prints no secrets)

# --- Azure OpenAI: one resource, two deployments ---
# Azure portal -> your Azure OpenAI resource -> "Keys and Endpoint".
# The base URL is enough; a full "Target URI" with a path also works (the code keeps only https://<host>).
# No api-version is needed: the code uses Azure's v1 API (<endpoint>/openai/v1/).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Deployment names, exactly as in Azure AI Foundry -> Deployments
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search (free tier) ---
# Azure portal -> your Search service -> Overview (URL) and Settings -> Keys (primary admin key)
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=kjv-parents

# --- Langfuse Cloud (EU region, Hobby plan) ---
# cloud.langfuse.com -> your project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Tracing is on when the keys above are set; set this to false to switch it off (the tests always switch it off)
# LANGFUSE_TRACING_ENABLED=false

# --- Azure AI Content Safety (phase 5, optional) ---
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# AZURE_CONTENT_SAFETY_KEY=
